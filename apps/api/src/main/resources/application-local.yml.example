# Copy to application-local.yml and fill in your local database.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/bookstudio
    username: your_username
    password: your_password
  jpa:
    show-sql: true
  flyway:
    # Demo data (db/seed) is loaded only outside prod
    locations: classpath:db/migration,classpath:db/seed

springdoc:
  swagger-ui:
    enabled: true

app:
  demo:
    enabled: true
  security:
    jwt:
      # Development-only secret; never reuse it outside local/docker.
      secret: dev-only-bookstudio-jwt-secret-change-me-0123456789
